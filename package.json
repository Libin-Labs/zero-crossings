{
  "name": "@lp-labs/zero-crossings",
  "version": "0.1.0",
  "description": "Sign-change sample indices with explicit zero skipping.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "npm run build && node scripts/check-types.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "format": "prettier --write src scripts tests *.json README.md",
    "format:check": "prettier --check src scripts tests *.json README.md",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "prettier": "^3.6.2"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 100,
    "endOfLine": "lf"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Libin Prasanth",
    "url": "https://www.linkedin.com/in/libinprasanth/"
  },
  "funding": {
    "type": "paypal",
    "url": "https://www.paypal.me/LibinPrasanth"
  }
}
